# Polymarket wallet
POLY_PRIVATE_KEY=0x_your_private_key_here
POLY_FUNDER=          # leave blank for EOA (defaults to key's address)

# Mode
DRY_RUN=true          # true = paper trading, false = live
LOG_LEVEL=INFO

# Strategy tuning
MOMENTUM_THRESHOLD=0.0008    # 0.08% in 60s
ORACLE_LAG_THRESHOLD=0.0003  # 0.03% divergence
MAX_ENTRY_PRICE=0.55         # max price for target side
MIN_CONFIDENCE=0.70          # minimum confidence to trade
INITIAL_BALANCE=20.0         # starting bankroll in USDC

# Risk
STOP_LOSS_BALANCE=10.0
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_LOSSES=2
COOLDOWN_MINUTES=30
DAILY_DRAWDOWN_LIMIT=0.50
TARGET_BALANCE=100000.0
